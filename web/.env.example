# The React website server proxy calls the independent FastAPI backend.
BACKEND_BASE_URL=http://127.0.0.1:8001
BACKEND_APP_TOKEN=local-development-token
# Must be longer than backend AGENTRUN_TIMEOUT_SECONDS so the Python backend
# can return its structured timeout response first.
BACKEND_ANALYSIS_TIMEOUT_SECONDS=660

# Public website origin used to build absolute Open Graph image URLs.
PUBLIC_SITE_URL=http://localhost:3001
