# Token used only between the website server proxy and this Python backend.
BACKEND_APP_TOKEN=local-development-token

# mock: test the complete upload/UI flow without Alibaba Cloud credentials.
# agentrun: call the minimal Agent Run service.
ANALYSIS_MODE=mock

# Local minimal agent example:
AGENTRUN_CHAT_COMPLETIONS_URL=http://127.0.0.1:9000/openai/v1/chat/completions
# After cloud deployment, paste the complete OpenAI-compatible chat URL here.
# AGENTRUN_CHAT_COMPLETIONS_URL=https://.../invocations/openai/v1/chat/completions

# Leave empty for an anonymous local Agent Run service. In the cloud, set the
# Agent Run endpoint credential here; never expose it to React. Agent Run API
# Key credentials normally use the raw key in the X-API-Key header.
AGENTRUN_API_KEY=
AGENTRUN_AUTH_HEADER=X-API-Key
AGENTRUN_AUTH_SCHEME=
# Maximum time to wait for model analysis. Large documents may need several
# minutes. Keep this shorter than the website proxy timeout.
AGENTRUN_TIMEOUT_SECONDS=600
# Fail quickly when the endpoint itself cannot be reached; this does not limit
# how long the model may spend generating its answer.
AGENTRUN_CONNECT_TIMEOUT_SECONDS=20
AGENTRUN_MODEL_NAME=qwen3.7-plus
AGENTRUN_ENABLE_SEARCH=true

# Show the complete model message between BEGIN/END markers in the backend
# terminal. It may contain document-derived financial information, so keep this
# disabled in shared or production log environments unless explicitly needed.
AGENTRUN_LOG_OUTPUT=true
AGENTRUN_LOG_OUTPUT_MAX_CHARS=30000

# DEBUG also prints parsed source locators. INFO shows normal stage progress,
# timings, validated question summaries, retries, and errors.
LOG_LEVEL=INFO

MAX_DOCUMENT_CHARS=120000
BACKEND_PORT=8001
