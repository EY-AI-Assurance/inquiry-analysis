# Values required by the minimal Agent Run package.
MODEL_SERVICE_NAME=model-xxxxxx
MODEL_NAME=qwen3.7-plus
MODEL_ENABLE_SEARCH=true
AGENT_PORT=9000

# Required only when the Agent Run SDK calls your configured model service from
# your own computer. Use the exact credential variable names required by your
# Agent Run workspace/SDK configuration and never include them in the ZIP.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
AGENTRUN_ACCOUNT_ID=
AGENTRUN_REGION=cn-hangzhou
